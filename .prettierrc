{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": false,
    "semi": true,
    "trailingComma": "none",
    "bracketSpacing": true,
    "printWidth": 140,
    "plugins": ["prettier-plugin-apex"],
    "overrides": [
        {
            "files": ["*.cls", "*.trigger", "*.apex"],
            "options": {
                "tabWidth": 4,
                "printWidth": 140,
                "singleQuote": false,
                "trailingComma": "none",
                "apexInsertFinalNewline": true
            }
        },
        {
            "files": ["**/lwc/**/*.html"],
            "options": {
                "tabWidth": 4,
                "parser": "lwc",
                "singleQuote": false,
                "trailingComma": "none"
            }
        },
        {
            "files": ["**/lwc/**/*.js"],
            "options": {
                "tabWidth": 4,
                "parser": "babel",
                "singleQuote": false,
                "trailingComma": "none"
            }
        },
        {
            "files": ["**/lwc/**/*.css"],
            "options": {
                "tabWidth": 4,
                "parser": "css",
                "singleQuote": false,
                "trailingComma": "none"
            }
        },
        {
            "files": ["*.cmp", "*.page", "*.component"],
            "options": {
                "parser": "html",
                "tabWidth": 4,
                "singleQuote": false
            }
        }
    ]
}
 